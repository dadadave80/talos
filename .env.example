# No values are ever committed. Keys live only in the deployment env and the owner's shell.
ARC_MAINNET_RPC=          # chain 5042
ARC_TESTNET_RPC=          # chain 5042002
OWNER_ADDRESS=            # human owner: signs escalations and timelock ops
AGENT_SESSION_KEY=        # agent signer; commit/pay/queue only, within caps. Never the owner key.
GATEWAY_API_KEY=          # Circle Gateway nanopayments (toll), Arc mainnet domain 26
X402_PAYEE_URLS=          # services the agent pays for itself, each with a cap
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODEL=
GITHUB_TOKEN=             # read-only; verifies merged PRs on dadadave80/lattice
TEAM_WALLETS=             # comma-separated; labelled `team`, excluded from traction
ARC_CANTEEN_TOKEN=        # arc-canteen update-traction
