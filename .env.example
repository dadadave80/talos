# No values are ever committed. Keys live only in the deployment env and the owner's shell.
ARC_MAINNET_RPC=                  # chain 5042
ARC_TESTNET_RPC=                  # chain 5042002
CHAIN=                            # arc | arc-testnet
OWNER_ADDRESS=                    # human owner (EOA): signs escalations and timelock ops. Never an agent key.
TALOS_VAULT=                      # the diamond address on CHAIN
CIRCLE_API_KEY=                   # TEST key on testnet, LIVE key on mainnet (separate)
CIRCLE_ENTITY_SECRET=             # registered by the owner; recovery file lives outside the repo
CIRCLE_AGENT_WALLET_ID=           # agent's Circle dev-controlled EOA: commit/pay/queue
CIRCLE_AGENT_WALLET_ADDRESS=
HOT_COMMIT_KEY=                   # commit-only signer for REFUSE commits; ~2 USDC of gas, nothing else
HOT_COMMIT_ADDRESS=
VENDOR_ALLOWLIST=                 # comma-separated, set at init (ops float = agent Circle EOA)
CONTRIBUTOR_ALLOWLIST=            # comma-separated, set at init
NEXT_PUBLIC_CIRCLE_MODULAR_CLIENT_KEY=
NEXT_PUBLIC_CIRCLE_MODULAR_CLIENT_URL=
FACILITATOR_BASE_URL=             # Circle Facilitator Service
FACILITATOR_NETWORK=              # eip155:5042 | eip155:5042002
TOLL_PAY_TO=                      # = TALOS_VAULT
LLM_API_KEY=                      # Groq
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=qwen/qwen3-32b
GITHUB_TOKEN=                     # read-only; verifies merged PRs on dadadave80/lattice
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
CRON_SECRET=                      # bearer for POST /api/cycle (GitHub Actions secret of the same name)
TEAM_WALLETS=                     # comma-separated; labelled `team`, excluded from traction
ARC_CANTEEN_TOKEN=                # arc-canteen update-traction
